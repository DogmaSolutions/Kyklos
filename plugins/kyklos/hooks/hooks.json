        ]
      },
      {
        "matcher": "Bash|mcp__KyklosBridge__(get_mutation|get_job_result)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-mutation-timing.sh\" after"
          }
        ]
      },
      {
        "matcher": "mcp__KyklosBridge__(get_coverage|run_tests)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-phase-advance.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-ask-first-guard.sh\" post"
          }
        ]
      }
