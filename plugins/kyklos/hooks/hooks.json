          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-ask-first-guard.sh\" pre"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-session-continuation-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__KyklosBridge__(run_tests|build)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-scenario-gate.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__KyklosBridge__(build|run_tests)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-story-before-coding-guard.sh\" bridge"
          }
        ]
      },
      {
        "matcher": "mcp__KyklosBridge__(build|run_tests|get_coverage|get_mutation|cleanup|kill_process|restart|stop)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-fork-bridge-surface.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__KyklosBridge__(mr_auto_merge|mr_create|mr_update|mr_merge)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-automerge-coverage-guard.sh\"",
            "timeout": 3700
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-ask-user-guard.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__KyklosBridge__get_mutation",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-mutation-timing.sh\" before"
          }
        ]
      },
      {
        "matcher": "NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/kyklos-ask-first-guard.sh\" pre"
          }
        ]
      }
    ],
