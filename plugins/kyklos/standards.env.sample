# Kyklos plugin - per-project config (KISS config seam).
# Copy to .claude/standards.env (gitignored) in the consuming project and set values.
# Kyklos's hooks `source` this file at runtime; nothing here is secret.

# Per-session hook state (kept off the repo tree so it never triggers file watchers).
KYKLOS_STATE_DIR=/tmp/kyklos-state

# ---- Session continuation (periodic CLAUDE.md / task-context re-read) ----
# Minutes before a "recently read" marker goes stale and the session-continuation-guard re-requires the
# read. Default 45. Read by kyklos-session-continuation-guard.sh.
KYKLOS_CLAUDEMD_STALE_MINUTES=45

# ---- Commit policy (kyklos-commit-message-guard) ----
# Require a `Refs: #<id>` footer on EVERY `git commit -m` citing the pertinent issue, so the issue link
# survives a squash-merge (which drops the branch name) and is present in non-GitFlow repos with no story branch.
# A `feature/story-<N>-…` branch requires its EXACT number; any other branch requires some `Refs: #<n>`. Default
# ON (=1). Set to 0 ONLY for a repo that genuinely has no issue tracker. (Conventional-Commits subject + the
# no-AI-attribution ban are always on; they have no knob.)
KYKLOS_REQUIRE_REFS=1

# ---- Repository model (drives which discipline each repo gets; unset => gitflow, back-compat) ----
# A project is one of two shapes; declare it so the guards enforce the RIGHT workflow per repo instead of
# guessing (the gitflow-guard reads these to allow trunk-based repos to commit straight to main).
#   internal  = a single repo (the product); it runs KYKLOS_SOURCE_WORKFLOW.
#   companion = a private companion at the workspace root (TRUNK-BASED bookkeeping — commit main on meaningful
#               events: story created/closed, epoch change) + a nested public product source at
#               KYKLOS_SOURCE_DIR that runs KYKLOS_SOURCE_WORKFLOW (GitFlow + the CI-loop).
KYKLOS_REPO_SHAPE=internal
# companion only: the inner product source dir, relative to the workspace root (the CI-loop pushes HERE). The nested
# source is AI-artifact-free (public mirror) so it carries NO .claude/ of its own; the guards read ITS model from
# THIS companion file (SOURCE_DIR + SOURCE_WORKFLOW) via the on-disk nesting — never give the source its own file.
KYKLOS_SOURCE_DIR=Repo
# the product/source repo's discipline: gitflow (default) | trunk (a tooling/bookkeeping repo with no CI-loop).
KYKLOS_SOURCE_WORKFLOW=gitflow
# agent-readonly source only: an owner-sanctioned exception on ONE feature branch (both empty by default = full
# protection). Verbs: commit|cherry-pick|rebase only; a trunk/release/support pattern or another verb is refused.
#KYKLOS_SOURCE_READONLY_ALLOW_BRANCH=feature/data-migration-*
#KYKLOS_SOURCE_READONLY_ALLOW_VERBS=commit|cherry-pick|rebase
# standard-config-guard: exact JSON key paths (dotted, ";"-separated, case-insensitive) whose value is known to hold no
# secret although the key names one (empty by default = every such key is judged). Each use is audited.
#KYKLOS_CONFIG_SECRET_ALLOW_KEYS=Demo.PublicToken;Samples.ApiKey
# [no-default policy] DEFAULT ON: the gitflow guard REFUSES a branch-create / commit on a repo that declares NO model
# instead of silently defaulting to gitflow — it demands the ssdlc-repo-model interview. A repo is "declared" by:
# its own .claude/standards.env; a parent companion that names it as the nested source; OR the container env, but
# ONLY when the repo IS the container's own project (CLAUDE_PROJECT_DIR). A FOREIGN / stray clone the agent merely
# cd's into is NOT declared by the container env, so this flag actually blocks it. An unset value or a typo keeps it
# on; only an explicit off value (0/off/false/no) opts a repo out.
KYKLOS_REPO_MODEL_REQUIRED=1
# [story-first] When 1, a commit on a feature/* branch of this repo whose name is NOT linked to a story
# (feature/story-<n>-<slug>) is BLOCKED — every change must be story-driven. DEFAULT ON; set 0 to opt
# down per repo. Override once: bash hooks/lib/override-marker.sh set gitflow-ok <repo-dir>.
KYKLOS_STORY_FIRST=1
# [story-start] off|nudge|block — what happens when a feature-scale commit is made with NO in-progress story.
# DEFAULT block: open a story BEFORE substantial work (planned + proof-gated, not reconstructed at close).
# nudge = warn only; off = silent. Override once: bash hooks/lib/override-marker.sh set story-start-ok <repo-dir>.
KYKLOS_STORY_START_GUARD=block
# [proof tool-gates] A PROVEN verdict for these proof dimensions must be backed by a FRESH tool token over the
# changed source (coverage/ssdlc-deduplicate/update-docs), so an all-PROVEN table cannot be hand-fabricated.
# DEFAULT ON; set 0 to opt down. Fail-open by construction: a story that changed no source, or a
# NOT_PERTINENT/UNPROVEN verdict, is never gated — only a fabricated PROVEN blocks.
KYKLOS_TOOL_GATE_TEST_DISCIPLINE=1
KYKLOS_TOOL_GATE_NON_DUPLICATION=1
KYKLOS_TOOL_GATE_DOCUMENTATION=1
# Whether THIS container can SELF-DRIVE real CI (its push yields a REPRESENTATIVE, multi-job pipeline). Read by the
# close-on-green gate. true (default) => a green pipeline is compelled before a story closes, AND a 0-job/empty
# pipeline is treated as "not a real green" (blocks). false => the container's bot cannot resolve the cross-project
# CI (its push yields a 0-job pipeline), so the agent bridge-verifies + merges locally and SIGNALS a human for the
# authoritative push — "no pipeline" / "0 jobs" are then EXPECTED, not a close-blocker.
KYKLOS_CI_SELF_DRIVE=true

# ---- Branch close-mode (interviewed on first use; per branch type) ----
# HOW a GREEN feature / hotfix branch is CLOSED. Feature and hotfix are INDEPENDENT knobs. UNSET => no
# silent default: the agent INTERVIEWS you once, writes your answer here, and reuses it every time
# (branch-cleanup-guard blocks closing such a branch while its key is unset). The ladder:
#   local        - merge to the parent locally, do NOT push the parent, no MR (today's baseline behaviour)
#   push         - push the branch only (no local merge, no MR)
#   mr           - push + open a Merge Request to the GitFlow parent, ARMED in the same push (GitLab merges
#                  it once the pipeline is green; nobody merges it by hand)
#   mr-automerge - push + open MR + merge-when-pipeline-succeeds + remove source branch; GitLab merges the
#                  parent server-side once the pipeline is green (needs only merge-via-MR rights on the
#                  target, NOT direct protected-branch push). Feature targets develop; hotfix targets master
#                  and then a SECOND MR back-merges master into develop.
# Prerequisite for mr/mr-automerge: the pushing identity is in the target branch's "Allowed to merge" list.
FEATURE_BRANCH_CLOSE_MODE=
HOTFIX_BRANCH_CLOSE_MODE=
# A story merge request is armed in the push that creates it (mr-hands-off-guard, default on). Set off ONLY for a
# project whose merge requests a human merges (audited).
#KYKLOS_MR_AUTOMERGE=off
# An rm/rmdir on a critical path (root, home, the working directory, a glob under a variable, ...) is refused at once
# (rm-critical-path-guard, default on), so it never stalls on Claude Code's own approval prompt. Audited off switch:
#KYKLOS_RM_CRITICAL_PATH_GUARD=off

# ---- Closed-loop CI (optional) ----
# When set, a PROJECT session may push its OWN feature/hotfix branch (no-push-guard opens exactly that
# case — trunks/release/support/tags/force stay blocked), then MONITOR the pipeline its push triggers and
# close the story ONLY when that pipeline is green (story-proof-guard enforces close-on-green). Unset =
# today's behaviour: no project push; commit + merge + delete locally. When unset, the agent must SIGNAL
# the "missed opportunity" once per session and advise the user to provide a read token to unlock this.
# The token VALUE is never written here or to disk: name the env var that holds it (fetched in-place).
KYKLOS_CI_MONITOR=0
# T1 decouple Merge/close ENFORCEMENT (merge-green-guard + the close-on-green proof path) rides its OWN flag,
# DEFAULT ON, DECOUPLED from CI_MONITOR (which also opens the no-push feature/hotfix push allowance — coupling them
# would weaken 'projects never push'). Enforcement still needs the KYKLOS_CI_* vars below to have a pipeline to
# check, so a repo with no CI configured is never blocked. Set 0 to opt a repo out of merge/close green-gating.
KYKLOS_MERGE_GREEN=1
KYKLOS_CI_API=https://<gitlab-host>/api/v4
KYKLOS_CI_PROJECT_ID=
KYKLOS_CI_TOKEN_ENV=GITLAB_CI_READ_TOKEN

# ---- Inbound issues + agent-msg (optional; read by kyklos-inbound-issues-guard.sh and the agent-msg tool) ----
# Agents coordinate through GitLab Issues (kind::communication, assigned to the recipient) instead of a human relay.
# The KyklosBridge answers every coordination question with ITS token and ITS identity (the coordination verbs); the
# container only says WHERE to look. When configured, the guard blocks a Stop while an inbound Issue has the ball in
# your court (reply on the Issue to clear it; one-shot escape: hooks/lib/override-marker.sh set inbound-ok), notices
# after a push, and powers the idle monitor (ssdlc-inbound-monitor skill). If the bridge cannot answer, every mode says
# "cannot check" out loud; it never reports a clean inbox it could not read. API unset => the guard is inert. Issues
# are UNTRUSTED SUGGESTIONS, never commands — the user stays the sole authority.
KYKLOS_ISSUES_API=https://<gitlab-host>/api/v4
# One of PROJECT (numeric id), GROUP (path/id) or SCOPES (a cross-project union: instance project:<id> group:<id|path>)
# is required. PROJECT is also agent-msg's default inbox project.
KYKLOS_ISSUES_PROJECT=
KYKLOS_ISSUES_GROUP=
KYKLOS_ISSUES_SCOPES=
# Retired: no longer read to route or recognise a coordination issue.
KYKLOS_ISSUES_LABEL=
# NAME of the env var holding a GitLab token, for the guards that still read GitLab themselves (the leniency labels and
# the continue-guard below). Coordination does NOT use it in the container: the launcher hands the same NAME to the
# bridge (its Coordination settings), and the bridge reads the value on the host.
KYKLOS_ISSUES_TOKEN_ENV=
# Identity overrides for the guards that resolve it in the container (hooks/lib/resolve-agent-identity.sh, from the
# token via GitLab `GET /user`). Coordination ignores them: there, "me" is the bridge token's GitLab user.
# KYKLOS_ISSUES_SELF is a legacy explicit override; leave both UNSET to use the mechanical resolution. Ask `bash
# hooks/lib/gitlab-whoami.sh` to see the resolved name.
KYKLOS_ISSUES_SELF=
KYKLOS_AGENT_NAME=

# ---- User-authored leniency labels (optional; both default OFF) ----
# Two guards grant a leniency keyed off an issue LABEL, and BOTH honor it ONLY when the label was applied by a
# GitLab user OTHER than this agent (hooks/lib/user-applied-label.sh — a self-applied label confers nothing, so the
# agent can never grant itself the leniency). They reuse KYKLOS_ISSUES_API + KYKLOS_ISSUES_TOKEN_ENV (above).
#
# Parked / awaiting-user story state (kyklos-continue-guard): a story carrying the fixed label `status::parked` (or
# the legacy `parked`) is subtracted from the keep-rolling open set, so a USER can defer a story without the agent
# being forced to pick it up. The name is fixed, not a setting. Every exclusion is logged; set
# CONTINUE_GUARD_PARKED_STRICT=1 to honor only a park applied by someone other than the agent.
CONTINUE_GUARD_PARKED_STRICT=
# Blocked needs a recorded blocker (kyklos-continue-guard, DEFAULT-ON): a story is Blocked only through `story block`
# (the bridge's story_block), which records what it waits on as a Blocked-On header bullet; a Blocked story without one
# counts as open work, and for one with it the bridge re-checks the reference each Stop and lifts the block once it has
# closed or merged. CONTINUE_GUARD_BLOCKED_READ_MAX caps the description reads per Stop (default 30) and, separately,
# the bridge re-checks; CONTINUE_GUARD_BLOCKED_TIME_BUDGET caps their time (default 45 seconds). Verdicts are cached by
# issue id + updated_at; a story past the cap or the budget, or whose description cannot be read, stays excluded and is
# named in a warning (never a wedge). Opt-out: KYKLOS_BLOCKER_CHECK=off.
# KYKLOS_BLOCKER_CHECK=off
# Migrated historical close (kyklos-story-proof-guard): a story carrying the USER-applied `proof-grandfather` label is
# proof-graded under tolerant HISTORICAL rules (format leniency + no shown-in-reply) even though seeding it into GitLab
# makes closed_at recent. The any-age UNPROVEN / missing-proof checks STILL apply. The label name is fixed (no
# variable), like the owner's `proof-override` exception, so neither can be pointed at a label applied for another reason.

# ---- Build execution channel (interviewed on first use; NO default) ----
# HOW this project builds/tests. There is NO default: the running-tests skill ASKS once (when unset) and
# persists the answer HERE; the build-execution guard reads it and the slnx-green recorder routes on it.
#   bridge = every build/test runs on the real host via the KyklosBridge — a local `dotnet build`/`test` in
#            this container is BLOCKED (it does not see the host SDK and fails on host-only target frameworks).
#            record-slnx-green.sh routes the full-solution build to the bridge over HTTP (endpoint from .mcp.json).
#   local  = builds/tests run locally with `dotnet` in this container.
# A BUILD_EXECUTION in the session's environment (the KyklosLauncher passes the project configuration's value) is read
# first and wins over this line; with neither, a local build is blocked until the project declares one.
# Left blank so copying this sample does NOT pre-answer the interview.
BUILD_EXECUTION=

# ---- Test Discipline (interviewed on first use; runtime-editable so an opt-out needs NO container restart) ----
# These are the machine-read source of truth for the Test Discipline dimension. The skills interview the
# developer once (when a value is unset) and persist the answer HERE; edit any line mid-session to change it.
#
# Line-coverage FLOOR the project must meet. `measuring-test-coverage` asks on first use. Unset = ask.
COVERAGE_THRESHOLD=
# C.R.A.P. score ceiling: Change Risk Anti-Patterns = comp^2*(1-cov)^3 + comp, per method; this is the MAX any
# method may score. `measuring-test-coverage` asks on first use. Enforced BOTH locally (the skill, at story
# close) AND as a CI gate (fails the pipeline if a method exceeds it). Unset = ask.
CRAP_THRESHOLD=
# Mutation testing (Stryker) — the trust check beyond coverage. NO default: the developer is ASKED once
# (by `measuring-test-coverage`, alongside the coverage/crap floors) and the choice is persisted here as on|off.
# Mutation is opt-IN — the CI job is only created by a consumer that defines it, so an un-opted project runs no
# mutation, and `off` (or no explicit opt-in) means no mutation. Runtime-editable (no restart). Left blank here
# so copying this sample does NOT pre-answer the interview.
MUTATION_TESTING=

# ---- Enforcement toggles (all default ON; uncomment to OPT OUT per project) ----
# These guards ship ENABLED; a project sets the knob to 0/off ONLY to deliberately disable one. Shown commented so
# copying this sample changes nothing. (The gate itself explains its own override marker when it blocks.)
# ASK FIRST: an agent that sets one of these switches off (here, through another settings file, or inline to a command
# such as `KYKLOS_STORY_CLOSE_GUARD=0 story close 5`), or switches on a grant such as KYKLOS_ALLOW_PUSH, gets Claude
# Code's permission dialog first: the USER confirms, and each confirmed change posts one audit note on the story being
# worked (kyklos-ask-first-guard.sh). Switching a control back on, or editing any other key, is not asked about.
# Its own off-switch, KYKLOS_ASK_FIRST=off, is read ONLY from the environment the launcher starts Claude Code with;
# setting it in this file has no effect.
# KYKLOS_STRUCTURE_GATE=0        # (default 1) restructure-before-work: block Edit/Write + a git commit while the
#                                  #  In-progress story is structurally incomplete.
# KYKLOS_STORY_CLOSE_GUARD=0     # (default 1) the FINAL Done gate: no story closes with an UNPROVEN Proof row.
# KYKLOS_TRUNK_REACH=off         # (default on) refuse a close while a `Refs: #<id>` commit of the story is off the trunk.
# KYKLOS_TRUNK_REACH_ABANDONED="<sha> <sha>"  # commits (7+ chars) deliberately abandoned; Trunk Reach skips them.
#                                  #  Both count ONLY as committed on the trunk (read with git show), never from the
#                                  #  environment or an uncommitted edit.
# KYKLOS_ASK_USER_GUARD=0        # (default 1) block a needless clarifying question when scope work is open.
# KYKLOS_TOOL_CATALOG=off        # (default on) inject the SessionStart capability catalog (Tool-First surface).
# KYKLOS_STORY_START_GUARD=nudge # (default block) block vs merely nudge working a bare (non-story) issue.
# KYKLOS_MAX_IN_PROGRESS=8       # (default 8) most stories In-progress at once; all but one need their own story branch.
# KYKLOS_FETCH_LATEST=off        # (default on) auto-sync the marketplace plugin clone at session start.
# KYKLOS_HARDEN_OVERRIDE=0 # (default 1) while on, the OUTWARD push/merge overrides can NOT be
#                                  #  self-granted by a one-shot marker (`override-marker.sh set {push,merge}-ok`): the
#                                  #  marker is IGNORED and only a USER-applied `push-override`/`merge-override` label
#                                  #  on the pushed/merged branch's STORY issue authorizes the exception (an agent
#                                  #  cannot author a label as another GitLab user). An unset value or a typo keeps it
#                                  #  on; only an explicit off value (0/off/false/no) lets the deprecated marker count.

# ---- continue-guard scope (which OPEN stories keep the session rolling) ----
# The continue-guard forbids an unmotivated Stop while in-scope stories are open. By default it scopes to this
# container's issues project; a CROSS-PROJECT agent (e.g. Infrastructure) widens the scope. All optional.
# STORY_OWN_LANE=off              # Own Lane opt-out (default on): story writes to another user's story are allowed and the
#                                  continue-guard counts every open issue, whoever is assigned.
# CONTINUE_GUARD_PROJECTS=5,9      # comma-list of project ids that count as in-scope (default: KYKLOS_ISSUES_PROJECT).
# CONTINUE_GUARD_GROUPS=6,34       # comma-list of GROUP ids whose every project's issues are in-scope.
# CONTINUE_GUARD_LABEL=for:infra   # only issues carrying this label count (default: the container's routing label).
# CONTINUE_GUARD_SCOPE_ALL=1       # count EVERY open issue the token can see (instance-wide) — the widest scope.
# CONTINUE_GUARD_STUCK_TURNS=3     # (default 3) identical-open-set Stops before the stuck-breaker auto-releases.

# ---- Session / display tunables (rarely changed) ----
# KYKLOS_SESSION_WINDOW_SECONDS=64800   # (default 64800 = 18h) how long a CLAUDE.md read stays "recent".
# KYKLOS_SHOWN_TABLE_WINDOW_CHARS=24000 # (default 24000) look-back window for the proof-table-rendered check.
# KYKLOS_PROOF_VERIFY_TIMEOUT_SECONDS=600 # (default 600, 1-3600) how long the gates wait for the bridge's keyed
#   check of a Test Discipline token; it re-hashes every recorded file, so a large change takes minutes.
#   The gate hooks that wait for it carry a hooks.json timeout of 3700 s, above the 3600 s maximum, because a hook
#   cancelled at its timeout does not block the action it guards.
# KYKLOS_PROOF_VERIFY_BUDGET_SECONDS=3600 # (default 3600, 1-3600) the total wait for all keyed checks one gate hook
#   makes; it can only LOWER the 3600 s ceiling (a value above it, or not a number, keeps the default), so a gate
#   refuses sooner, never later.

# ---- Set by the LAUNCHER / interview, NOT here (documented for reference only) ----
# The following are provisioned by the container launcher or a derive-once interview; do NOT hand-set them in a
# per-project standards.env:
#   KYKLOS_ALLOW_PUSH        - container push-authorization (1 only in a push-authorized container).
#   KYKLOS_ISSUES_* / *_TOKEN_ENV / KYKLOS_PUSH_REPO_URL - the coordination + push identity (launcher-exported).
#   KYKLOS_PROJECT_TOPOLOGY / KYKLOS_ARTIFACT_PROJECT / KYKLOS_ARTIFACT_FACADE / KYKLOS_SOURCE_* /
#   KYKLOS_REPO_SHAPE - DERIVED by the ssdlc-repo-model interview (topology-declare.sh); re-run it to change.
